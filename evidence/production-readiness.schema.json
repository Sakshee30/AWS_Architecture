{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Production readiness evidence",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "authentication_mfa_authorization",
    "tenant_isolation_all_boundaries",
    "versioned_forward_compatible_migrations",
    "optional_provider_fallbacks",
    "outbox_inbox_idempotency",
    "queue_retry_dlq_alert_replay",
    "s3_quarantine_security",
    "non_root_container_and_vulnerability_scan",
    "reproducible_iac_and_drift_detection",
    "approved_secret_stores_only",
    "otel_logs_metrics_traces_redaction",
    "slos_alerts_dashboards_runbooks",
    "backup_restore_tests",
    "load_security_chaos_tests",
    "control_plane_approval_health_rollback",
    "release_traceability"
  ],
  "properties":{
    "authentication_mfa_authorization":{"$ref":"#/$defs/check"},
    "tenant_isolation_all_boundaries":{"$ref":"#/$defs/check"},
    "versioned_forward_compatible_migrations":{"$ref":"#/$defs/check"},
    "optional_provider_fallbacks":{"$ref":"#/$defs/check"},
    "outbox_inbox_idempotency":{"$ref":"#/$defs/check"},
    "queue_retry_dlq_alert_replay":{"$ref":"#/$defs/check"},
    "s3_quarantine_security":{"$ref":"#/$defs/check"},
    "non_root_container_and_vulnerability_scan":{"$ref":"#/$defs/check"},
    "reproducible_iac_and_drift_detection":{"$ref":"#/$defs/check"},
    "approved_secret_stores_only":{"$ref":"#/$defs/check"},
    "otel_logs_metrics_traces_redaction":{"$ref":"#/$defs/check"},
    "slos_alerts_dashboards_runbooks":{"$ref":"#/$defs/check"},
    "backup_restore_tests":{"$ref":"#/$defs/check"},
    "load_security_chaos_tests":{"$ref":"#/$defs/check"},
    "control_plane_approval_health_rollback":{"$ref":"#/$defs/check"},
    "release_traceability":{"$ref":"#/$defs/check"}
  },
  "$defs":{
    "check":{
      "type":"object",
      "additionalProperties":false,
      "required":["passed","evidence"],
      "properties":{
        "passed":{"const":true},
        "evidence":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
        "notes":{"type":"string"}
      }
    }
  }
}
