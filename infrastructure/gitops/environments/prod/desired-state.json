{
  "schemaVersion": 1,
  "environment": "prod",
  "infrastructure": {
    "enable_redis": true,
    "enable_msk": true,
    "enable_opensearch": false,
    "enable_eks": false,
    "enable_ecs": true,
    "enable_gpu_nodes": false,
    "enable_alb": true
  },
  "changePolicy": {
    "sourceOfTruth": "git",
    "directAwsMutationFromBrowser": false,
    "requireHealthVerification": true,
    "automaticRollbackOnHealthFailure": true
  }
}
