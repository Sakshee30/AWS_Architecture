application_name = "platform"
owner            = "platform-team"
cost_center      = "engineering"

vpc_cidr                   = "10.40.0.0/16"
azs                        = ["ap-south-1a", "ap-south-1b"]
public_subnet_cidrs        = ["10.40.0.0/24", "10.40.1.0/24"]
private_app_subnet_cidrs   = ["10.40.10.0/24", "10.40.11.0/24"]
isolated_data_subnet_cidrs = ["10.40.20.0/24", "10.40.21.0/24"]

enable_redis      = true
enable_msk        = false
enable_opensearch = false

# ECS is the production baseline until the EKS ingress and capacity path has
# equivalent runtime evidence. Do not enable both compute providers together.
enable_ecs       = true
enable_eks       = false
enable_gpu_nodes = false

enable_alb        = true
enable_cloudfront = true

container_image = "REPLACE_WITH_ECR_REPOSITORY@sha256:REPLACE_WITH_64_HEX_DIGEST"
certificate_arn = "REPLACE_WITH_REGIONAL_ACM_CERTIFICATE_ARN"

cloudfront_certificate_arn = null
cloudfront_aliases         = []
