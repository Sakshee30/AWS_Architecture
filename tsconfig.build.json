{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "declaration": false,
    "noEmit": false,
    "noEmitOnError": true,
    "outDir": "./dist",
    "rootDir": ".",
    "sourceMap": true
  },
  "include": [
    "apps/api/**/*.ts",
    "apps/workers/**/*.ts",
    "apps/platform-control-api/**/*.ts",
    "services/**/*.ts",
    "packages/**/*.ts",
    "adapters/**/*.ts"
  ],
  "exclude": [
    "apps/web/**",
    "apps/platform-admin/**",
    "tests/**",
    "**/*.test.ts",
    "**/*.test.mjs"
  ]
}
